# /etc/domaindoctor/agent.env  (chmod 600)
# Bind to the private interface only; never 0.0.0.0 on a host with a public IP unless ufw restricts it.
AGENT_LISTEN=10.0.0.2:9090
AGENT_SECRET=REPLACE_WITH_64_HEX_CHARS
# Alternatively: AGENT_SECRET_FILE=/etc/domaindoctor/agent.secret
# HTTPS (needed when the master reaches this agent over the public internet). Create with:
#   domaindoctor-agent gen-cert -dir /etc/domaindoctor   (prints cert_sha256 for nodes.json)
#AGENT_TLS_CERT=/etc/domaindoctor/agent.crt
#AGENT_TLS_KEY=/etc/domaindoctor/agent.key
