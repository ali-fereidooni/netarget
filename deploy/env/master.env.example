# /etc/domaindoctor/master.env  (chmod 600, owner root:domaindoctor)
LISTEN_ADDR=127.0.0.1:8082
NODES_FILE=/etc/domaindoctor/nodes.json
# Shared agent secret (32-byte hex: openssl rand -hex 32). Per-node secrets: see secret_env in nodes.json.
AGENT_SECRET=REPLACE_WITH_64_HEX_CHARS
# 1 = also probe from the master itself (single-node mode is automatic when NODES_FILE is unset)
LOCAL_AGENT=0
LOCAL_NODE_NAME=Master node
LOCAL_NODE_LOCATION=DE
# Number of reverse proxies in front of the master (nginx = 1, CDN + nginx = 2)
TRUSTED_PROXY_HOPS=1
# Only honour X-Forwarded-For from these peers (comma-separated IPs/CIDRs)
TRUSTED_PROXY_CIDRS=127.0.0.1,::1
REPORTS_DIR=/var/lib/domaindoctor/reports
REPORTS_CAP=2000
MAX_CONCURRENT_CHECKS=30
# Optional ipinfo-style CSV/CSV.GZ for ASN enrichment (see INSTALL.md)
#ASN_CSV_PATH=/var/lib/domaindoctor/ipinfo_lite.csv.gz
